# eto secrets — copy to .env (gitignored; never committed).
# These are the editor's short names; src/env.ts maps them onto the AWS
# SDK's standard names at load. Only needed for the email edition and the
# reader-list backup — the paper prints without them.
#
# The IAM user (eto-press) needs: SES send, contact-list read/write,
# suppression-list read, account read. See docs/DEPLOY.md.
AWS_REGION=ca-central-1
AWS_ACCESS_KEY=your-access-key-id
AWS_SECRET=your-secret-access-key

# The Cloudflare Pages Functions carry their own bindings, set in the
# Pages dashboard (not read from this file):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — the same narrow IAM user
#   SUBSCRIBE_SECRET — any long random string; HMAC key for confirm links
