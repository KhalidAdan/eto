{
  "name": "eto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One story. Every side. Then it ends.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "probe": "tsx lab/probe-prompts.ts",
    "build:css": "tailwindcss -i src/brief.css -o site/brief.css --minify",
    "render": "npm run build:css && tsx src/render-site.ts",
    "email": "tsx src/send-edition.ts",
    "correct": "tsx src/correct.ts",
    "export": "tsx src/export-journal.ts",
    "backup": "tsx src/backup-journal.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@effect/platform": "latest",
    "@effect/platform-node": "latest",
    "@effect/sql": "latest",
    "@effect/sql-sqlite-node": "latest",
    "@mozilla/readability": "^0.6.0",
    "aws4fetch": "^1.0.20",
    "effect": "latest",
    "jsdom": "^29.1.1",
    "rss-parser": "^3.13.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.114.0"
  }
}
