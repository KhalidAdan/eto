    "backup:readers": "tsx node_modules/@eto-press/press/src/backup-readers.ts"
  },
  "dependencies": {
    "@eto-press/press": "^2.20260926.0",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.114.0"
